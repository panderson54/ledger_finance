SECRET_KEY=
DATABASE_URL=sqlite:///data/finance.db
FLASK_ENV=development

# Google sign-in (required). Create an OAuth "Web application" client in Google
# Cloud Console; its authorized redirect URI must match GOOGLE_REDIRECT_URI
# exactly (https + a domain name; only localhost may use http).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Required in production; optional for local dev (defaults to this server's own
# /auth/google/callback URL, e.g. http://localhost:5001/auth/google/callback).
GOOGLE_REDIRECT_URI=
# Comma-separated Google accounts allowed to use Ledger. This is the ONLY place
# access is granted; remove an address and restart to revoke it immediately.
LEDGER_ALLOWED_EMAILS=
