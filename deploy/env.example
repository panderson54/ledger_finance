# Copy to .env (gitignored): cp env.example .env and fill in. Generate every secret separately.
#   token:        python3 -c "import secrets; print(secrets.token_hex(32))"
#   cookie secret: python3 -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"

DOMAIN=example.com
ACME_EMAIL=you@example.com

# Google Cloud OAuth client (type: Web application) — README step 2
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
OAUTH2_PROXY_COOKIE_SECRET=

LEDGER_SECRET_KEY=
LEDGER_PROXY_SECRET=
# Per-app allowlist: who may open Ledger. Each address must also be in
# oauth2-proxy/allowed_emails.txt or they can't get past sign-in.
LEDGER_ALLOWED_EMAILS=you@gmail.com

HOMEBASE_SECRET_KEY=
HOMEBASE_PROXY_SECRET=
# Homebase's allowlist is its `users` table: `flask create-user --no-password`.

# Optional overrides (defaults shown)
# HOMEBASE_REPO=../../homebase
# LEDGER_DATA_DIR=../data
# HOMEBASE_DATA_DIR=../../homebase/data
